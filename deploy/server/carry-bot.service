[Unit]
Description=Delta-neutral funding carry bot (autopilot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/carry_bot
EnvironmentFile=/home/ubuntu/apps/carry_bot/.env
ExecStart=/home/ubuntu/apps/carry_bot/.venv/bin/python -m algo_engine.carry_bot.autopilot
Restart=on-failure
RestartSec=15
# give the bot time to unwind both legs on stop instead of being killed mid-hedge
KillSignal=SIGINT
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
