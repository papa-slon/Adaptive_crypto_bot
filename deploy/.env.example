# Copy to `.env` ON THE SERVER and fill in. NEVER commit the real .env.
# Bybit DEMO keys only (Demo Trading -> API). Demo is the default; the bot
# refuses mainnet unless you also pass --mainnet --yes-mainnet.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# carry sizing (start tiny)
CARRY_SYMBOL=BTCUSDT
CARRY_NOTIONAL=20      # USDT per leg
CARRY_LEVERAGE=1       # keep 1x until you've watched it work
CARRY_POLL=30          # seconds between monitor ticks
# CARRY_MAX_MINUTES=   # optional: auto-unwind after N minutes (leave blank to run until stopped)
