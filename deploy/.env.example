# Copy to `.env` ON THE SERVER and fill in. NEVER commit the real .env.
# Demo keys only to start. Demo endpoints are the default; the bot refuses a
# real-money venue unless you also pass --yes-mainnet.

# --- which exchange -------------------------------------------------------
# bybit-demo | bybit-testnet | bingx-demo | (bybit-mainnet | bingx-mainnet)
CARRY_VENUE=bingx-demo

# --- keys (fill the pair matching CARRY_VENUE) ----------------------------
BINGX_API_KEY=
BINGX_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- sizing ---------------------------------------------------------------
# Total USDT the bot may deploy across all slots. Each slot ties up its spot
# leg PLUS the perp margin, so notional per slot = (capital/slots)/(1 + 1/lev).
CARRY_CAPITAL=200
CARRY_SLOTS=3
CARRY_LEVERAGE=1          # keep 1x until you have watched it work

# --- cadence --------------------------------------------------------------
CARRY_POLL=30             # seconds between monitoring ticks
CARRY_RESCAN_MIN=60       # minutes between funding scans / rotations
